{
  "name": "rich-markdown-preview",
  "displayName": "Rich Markdown Preview - A Styled Markdown Preview",
  "description": "A styled Markdown preview with 18 reading themes, Mermaid diagrams, syntax highlighting, and searchable, sortable tables with CSV export.",
  "version": "2.0.0",
  "publisher": "kasunkodagoda",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=24.12.0 <25",
    "npm": ">=11 <12"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:markdownLens.openPreview",
    "onCommand:styledMarkdown.openPreview",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "richMarkdownPreview.openPreview",
        "title": "Open in Rich Markdown Preview",
        "icon": "$(preview)"
      },
      {
        "icon": {
          "light": "assets/rich-markdown-preview.png",
          "dark": "assets/rich-markdown-preview.png"
        },
        "command": "richMarkdownPreview.openDocumentationHome",
        "title": "Rich Markdown Preview: Open Documentation Home"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "richMarkdownPreview.openPreview",
          "when": "editorLangId == markdown || resourceExtname =~ /\\.md$/i",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "richMarkdownPreview.openPreview",
          "when": "editorLangId == markdown || resourceExtname =~ /\\.md$/i",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "command": "richMarkdownPreview.openPreview",
          "when": "(resourceLangId == markdown || resourceExtname =~ /\\.md$/i) && !explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "group": "navigation@20",
          "when": "view == workbench.explorer.fileView && workspaceFolderCount > 0",
          "command": "richMarkdownPreview.openDocumentationHome"
        }
      ]
    },
    "configuration": {
      "title": "Rich Markdown Preview",
      "properties": {
        "richMarkdownPreview.style": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "documentation",
            "reading",
            "technical",
            "github",
            "editorial",
            "book",
            "minimal",
            "academic",
            "swiss",
            "aurora",
            "botanical",
            "noir",
            "blueprint",
            "terracotta",
            "atelier",
            "ocean",
            "manuscript",
            "circuit"
          ],
          "default": "documentation",
          "enumDescriptions": [
            "Balanced documentation typography.",
            "Comfortable serif reading.",
            "Compact technical reference.",
            "Familiar GitHub-style system typography.",
            "Magazine-style serif prose and bold headlines.",
            "Warm book-inspired pages and classic serif text.",
            "Quiet sans-serif typography and generous whitespace.",
            "Formal serif typography for research and reports.",
            "Bold geometric headings, crisp red rules, and neutral sans-serif text.",
            "Purple display headings and soft, rounded sans-serif typography.",
            "Olive accents, humanist text, and graceful serif headings.",
            "Dramatic serif titles, gold accents, and restrained monochrome text.",
            "Monospaced section labels and structured blue technical panels.",
            "Warm clay colors, generous serif prose, and sculpted headings.",
            "Fashion-inspired display serif titles and small uppercase section labels.",
            "Airy sans-serif text, teal heading markers, and cool chart colors.",
            "Classic literary serif typography and chapter-style section ornaments.",
            "Precise sans-serif text, monospace headings, and green engineering accents."
          ],
          "description": "Preview typography and layout style."
        },
        "richMarkdownPreview.appearance": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "Preview color scheme."
        },
        "richMarkdownPreview.contentWidth": {
          "type": "number",
          "scope": "resource",
          "default": 900,
          "minimum": 480,
          "maximum": 1600,
          "description": "Maximum content width in pixels."
        },
        "richMarkdownPreview.fontSize": {
          "type": "number",
          "scope": "resource",
          "default": 16,
          "minimum": 12,
          "maximum": 24,
          "description": "Content font size in pixels."
        },
        "richMarkdownPreview.lineHeight": {
          "type": "number",
          "scope": "resource",
          "default": 1.7,
          "minimum": 1.3,
          "maximum": 2.2,
          "description": "Content line height."
        },
        "richMarkdownPreview.wrapCode": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "Wrap long lines in code blocks."
        },
        "richMarkdownPreview.openPreviewToSide": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Open the preview beside the source editor. Disable to open it as a new tab in the current editor group, without creating a split. Applies the next time you open or reveal a preview."
        },
        "richMarkdownPreview.referenceRoot": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Base directory for file references starting with /. Empty uses the document workspace folder, or document directory for standalone files. Set a workspace-relative path for a skill package root, or an absolute Windows path."
        },
        "richMarkdownPreview.documentation.include": {
          "scope": "resource",
          "description": "Workspace-relative glob for Documentation Home. Hidden folders such as .claude are included. Results are limited to Markdown files.",
          "default": "**/*.{md,MD,markdown,MARKDOWN}",
          "type": "string"
        },
        "richMarkdownPreview.documentation.exclude": {
          "scope": "resource",
          "description": "Folders and files excluded from Documentation Home. Uses its own glob instead of files.exclude or .gitignore, so hidden documentation remains discoverable. Set empty to include all matching Markdown files.",
          "default": "**/{.git,node_modules,bower_components,dist,build,out,coverage,.next,.venv,venv}/**",
          "type": "string"
        },
        "richMarkdownPreview.documentation.showStatusBar": {
          "description": "Show the Documentation Home button in the status bar when a workspace is open.",
          "default": true,
          "type": "boolean"
        }
      }
    },
    "keybindings": [
      {
        "command": "richMarkdownPreview.openPreview",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && (editorLangId == markdown || resourceExtname =~ /\\.md$/i)"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:production",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run build:production && npm run test:only",
    "dev:preview": "npm run build:development && node tests/preview-server.cjs",
    "vscode:prepublish": "npm run check:quality && npm run build:production && npm run test:only",
    "package": "vsce package --no-dependencies --githubBranch master && npm run verify:release",
    "test:coverage": "npm run build:production && npm run test:coverage:only",
    "test:browser": "npm run build:production && npm run test:browser:only",
    "verify:vsix": "node scripts/verify-vsix.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "test:package": "npm run build:production && npm run test:package:only",
    "build:development": "node build.mjs",
    "build:production": "node build.mjs --production",
    "test:only": "node --test tests/*.test.cjs",
    "test:coverage:only": "node --test --experimental-test-coverage tests/*.test.cjs",
    "test:browser:only": "node tests/browser.cjs && node tests/documentation-browser.cjs",
    "test:package:only": "node --test tests/package.test.cjs",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check \"src/**/*.ts\" eslint.config.mjs .prettierrc.json CONTRIBUTING.md SECURITY.md \".github/**/*.{md,yml}\" tests/quality.test.cjs",
    "format": "prettier --write \"src/**/*.ts\" eslint.config.mjs .prettierrc.json CONTRIBUTING.md SECURITY.md \".github/**/*.{md,yml}\" tests/quality.test.cjs",
    "check:quality": "npm run check && npm run lint && npm run format:check",
    "test:host": "npm run build:production && npm run test:host:only",
    "test:host:only": "node scripts/vscode-host.cjs",
    "test:host:package": "node scripts/vscode-host.cjs --mode package"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  },
  "overrides": {
    "katex": "^0.18.2"
  },
  "author": {
    "name": "Kasun Kodagoda"
  },
  "icon": "assets/rich-markdown-preview.png",
  "keywords": [
    "markdown",
    "markdown preview",
    "styled markdown",
    "rich markdown preview",
    "mermaid",
    "diagrams",
    "syntax highlighting",
    "tables",
    "csv",
    "reading",
    "themes",
    "documentation",
    "readme"
  ],
  "galleryBanner": {
    "color": "#1c7819",
    "theme": "dark"
  },
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/kasunkv/rich-markdown-preview.git"
  },
  "homepage": "https://github.com/kasunkv/rich-markdown-preview#readme",
  "bugs": {
    "url": "https://github.com/kasunkv/rich-markdown-preview/issues"
  },
  "files": [
    "package.json",
    "dist/extension.js",
    "dist/preview.js",
    "dist/preview.css",
    "assets/rich-markdown-preview.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "docs/rich-markdown-preview-light.png",
    "docs/rich-markdown-preview-dark.png"
  ]
}
