{
  "name": "rich-markdown-preview",
  "displayName": "Rich Markdown Preview - A Styled Markdown Preview",
  "description": "A styled Markdown preview with 18 reading themes, Mermaid diagrams, syntax highlighting, and searchable, sortable tables with CSV export.",
  "version": "1.0.0",
  "publisher": "kasunkodagoda",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:markdownLens.openPreview",
    "onCommand:styledMarkdown.openPreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "richMarkdownPreview.openPreview",
        "title": "Open in Rich Markdown Preview",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "richMarkdownPreview.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "richMarkdownPreview.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "command": "richMarkdownPreview.openPreview",
          "when": "resourceLangId == markdown && !explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "Rich Markdown Preview",
      "properties": {
        "richMarkdownPreview.style": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "documentation",
            "reading",
            "technical",
            "github",
            "editorial",
            "book",
            "minimal",
            "academic",
            "swiss",
            "aurora",
            "botanical",
            "noir",
            "blueprint",
            "terracotta",
            "atelier",
            "ocean",
            "manuscript",
            "circuit"
          ],
          "default": "documentation",
          "enumDescriptions": [
            "Balanced documentation typography.",
            "Comfortable serif reading.",
            "Compact technical reference.",
            "Familiar GitHub-style system typography.",
            "Magazine-style serif prose and bold headlines.",
            "Warm book-inspired pages and classic serif text.",
            "Quiet sans-serif typography and generous whitespace.",
            "Formal serif typography for research and reports.",
            "Bold geometric headings, crisp red rules, and neutral sans-serif text.",
            "Purple display headings and soft, rounded sans-serif typography.",
            "Olive accents, humanist text, and graceful serif headings.",
            "Dramatic serif titles, gold accents, and restrained monochrome text.",
            "Monospaced section labels and structured blue technical panels.",
            "Warm clay colors, generous serif prose, and sculpted headings.",
            "Fashion-inspired display serif titles and small uppercase section labels.",
            "Airy sans-serif text, teal heading markers, and cool chart colors.",
            "Classic literary serif typography and chapter-style section ornaments.",
            "Precise sans-serif text, monospace headings, and green engineering accents."
          ],
          "description": "Preview typography and layout style."
        },
        "richMarkdownPreview.appearance": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "Preview color scheme."
        },
        "richMarkdownPreview.contentWidth": {
          "type": "number",
          "scope": "resource",
          "default": 900,
          "minimum": 480,
          "maximum": 1600,
          "description": "Maximum content width in pixels."
        },
        "richMarkdownPreview.fontSize": {
          "type": "number",
          "scope": "resource",
          "default": 16,
          "minimum": 12,
          "maximum": 24,
          "description": "Content font size in pixels."
        },
        "richMarkdownPreview.lineHeight": {
          "type": "number",
          "scope": "resource",
          "default": 1.7,
          "minimum": 1.3,
          "maximum": 2.2,
          "description": "Content line height."
        },
        "richMarkdownPreview.wrapCode": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "Wrap long lines in code blocks."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "dev:preview": "npm run build && node tests/preview-server.cjs",
    "vscode:prepublish": "npm run check && npm test",
    "package": "vsce package --no-dependencies --githubBranch master",
    "test:coverage": "npm run build && node --test --experimental-test-coverage tests/*.test.cjs",
    "test:browser": "npm run build && node tests/browser.cjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "katex": "^0.18.2"
  },
  "author": {
    "name": "Kasun Kodagoda"
  },
  "icon": "assets/rich-markdown-preview.png",
  "keywords": [
    "markdown",
    "markdown preview",
    "styled markdown",
    "rich markdown preview",
    "mermaid",
    "diagrams",
    "syntax highlighting",
    "tables",
    "csv",
    "reading",
    "themes",
    "documentation",
    "readme"
  ],
  "galleryBanner": {
    "color": "#1c7819",
    "theme": "dark"
  },
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/kasunkv/rich-markdown-preview.git"
  },
  "homepage": "https://github.com/kasunkv/rich-markdown-preview#readme",
  "bugs": {
    "url": "https://github.com/kasunkv/rich-markdown-preview/issues"
  }
}
